-- each kind of value is decoded by its own decoder, and anything else is an error that says what was found
::dependency nanyx.json ./nanyx.json

import (
  nanyx.json/encode as encode
  nanyx.json/json as json
)

type User = (name: string, age: int, nickname: #some(string) | #none)

def user: json.Decoder(User) = json.record {
  def name = try json.field("name", json.string)
  def age = try json.field("age", json.int)
  def nickname = try json.field("nickname", json.optional(json.string))
  return User(name = name, age = age, nickname = nickname)
}

def userEncoder: json.Encoder(User) = encode.object(
  [
    encode.field("name", { u -> u.name }, encode.string)
    encode.field("age", { u -> u.age }, encode.int)
    encode.optionalField("nickname", { u -> u.nickname }, encode.string)
  ]
)

def show: [Console] (#some(a) | json.DecodeError | json.JsonError), json.Encoder(a) -> () = {
  | #some(x), encoder -> println(json.encodeWith(x, encoder))
  | failure, _ -> println(json.describe(failure))
}

show(json.decodeWith("2.5", json.float), encode.float)
show(json.decodeWith("-7", json.int), encode.int)
show(json.decodeWith("true", json.bool), encode.bool)
show(json.decodeWith('"hi"', json.string), encode.string)
show(json.decodeWith('[1, {"a": null}]', json.value), { v -> v })

show(
  json.decodeWith('{"en": "Hello", "fr": "Bonjour"}', json.dict(json.string))
  encode.dict(encode.string)
)

show(json.decodeWith("null", json.string), encode.string)
show(json.decodeWith("1e30", json.int), encode.int)
show(json.decodeWith("[]", json.bool), encode.bool)
show(json.decodeWith("\{}", json.float), encode.float)
show(json.decodeWith("[1, 2", json.int), encode.int)
