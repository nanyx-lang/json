-- json.decode says where a value doesn't fit the type it is read into, and why
::dependency nanyx.json ./nanyx.json

import nanyx.json/json as json

type Shape = #circle(float) | #rect(width: float, height: float) | #dot

type User = (
  name: string
  age: int
  nickname: #some(string) | #none
  shapes: list(Shape)
)

def show: [Console] (#some(a) | json.DecodeError | json.JsonError) -> () = {
  | #some(_) -> println("read")
  | failure -> println(json.describe(failure))
}

show(json.decode('{"name": "Bob", "age": 2.5, "shapes": []}', into = type User))
show(json.decode('{"name": "Bob", "shapes": []}', into = type User))

show(
  json.decode(
    '{"name": "Bob", "age": 2, "shapes": [{"circle": 1}, {"hexagon": 2}]}'
    into = type User
  )
)

show(json.decode('{"name": "Bob", "age": 2, "shapes": ["circle"]}', into = type User))

show(
  json.decode('{"name": "Bob", "age": 2, "shapes": [{"dot": null, "circle": 1}]}', into = type User)
)

show(json.decode('{"name": "Bob", "age": 2, "nickname": 7, "shapes": []}', into = type User))
show(json.decode("[1, true, 3]", into = type (int, bool)))
show(json.decode("[1, 2]", into = type (int, bool)))
show(json.decode("[1, 300]", into = type list(U8)))
show(json.decode("[1, 2", into = type list(int)))
show(json.decode('{"a": 1}', into = type map(string, string)))
show(json.decode("1", into = type (int -> int)))

-- a nominal type of another module, or one Typed shows, and a function can't be written or read
type Money = protected (cents: int)

def wallet = (owner = "Ada", cash = [Money(cents = 5)])

def written: [Console] (#some(string) | json.EncodeError) -> () = {
  | #some(text) -> println(text)
  | failure -> println(json.describe(failure))
}

written(json.encode(wallet))
written(json.encode(name = "f", run = { n -> n + 1 }))
println(json.encodeWith(Money(cents = 5), json.encoderFor(type Money)))
