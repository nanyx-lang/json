-- json.decode says where a value doesn't fit the type it is read into, and why
::install nanyx.json ./nanyx.json

import nanyx.json/json as json

type Shape = #circle(float) | #rect(width: float, height: float) | #dot

type User = (
  name: string
  age: int
  nickname: #some(string) | #none
  shapes: list(Shape)
)

def show: [Console] (#some(a) | json.DecodeError | json.JsonError) -> () = {
  | #some(_) -> println("read")
  | failure -> println(json.describe(failure))
}

show(json.decode(type User, '{"name": "Bob", "age": 2.5, "shapes": []}'))
show(json.decode(type User, '{"name": "Bob", "shapes": []}'))

show(json.decode(type User, '{"name": "Bob", "age": 2, "shapes": [{"circle": 1}, {"hexagon": 2}]}'))

show(json.decode(type User, '{"name": "Bob", "age": 2, "shapes": ["circle"]}'))

show(json.decode(type User, '{"name": "Bob", "age": 2, "shapes": [{"dot": null, "circle": 1}]}'))

show(json.decode(type User, '{"name": "Bob", "age": 2, "nickname": 7, "shapes": []}'))
show(json.decode(type (int, bool), "[1, true, 3]"))
show(json.decode(type (int, bool), "[1, 2]"))
show(json.decode(type list(U8), "[1, 300]"))
show(json.decode(type list(int), "[1, 2"))
show(json.decode(type map(string, string), '{"a": 1}'))
show(json.decode(type (int -> int), "1"))

-- a nominal type of another module, or one Typed shows, and a function can't be written or read
type Money = protected (cents: int)

def wallet = (owner = "Ada", cash = [Money(cents = 5)])

def written: [Console] (#some(string) | json.EncodeError) -> () = {
  | #some(text) -> println(text)
  | failure -> println(json.describe(failure))
}

written(json.encode(wallet))
written(json.encode(name = "f", run = { n -> n + 1 }))
println(json.encodeWith(Money(cents = 5), json.encoderFor(type Money)))
