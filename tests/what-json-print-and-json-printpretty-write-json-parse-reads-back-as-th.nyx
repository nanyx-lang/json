-- What json.print and json.printPretty write, json.parse reads back as the same value
::install nanyx.json ./nanyx.json

import nanyx.json/json as json

def show = { text ->
  match json.parse(text)
    | #some(value) -> println(json.print(value))
    | #invalidJson(e) -> println("{e.position} {e.line}:{e.column} {e.message}")
}

def value: json.Json = #object(
  [
    ("name", #string("Ada \"the first\" \\ Lovelace\n\u{e9}\u{1F600}\u{1}"))
    (
      "numbers"
      #array([#number(0.0), #number(-2.5), #number(1.5e-7), #number(1.0e21), #number(123456.789)])
    )
    ("flags", #array([#bool(true), #bool(false), #null]))
    ("empty", #object([]))
    ("nested", #object([("a", #array([#array([]), #object([("b", #string(""))])]))]))
  ]
)

println(json.parse(json.print(value)) == #some(value))
println(json.parse(json.printPretty(value, indent = 2)) == #some(value))
println(json.parse(json.printPretty(value, indent = 0)) == #some(value))

println(
  json.print(value) == json.print(orCrash(json.parse(json.printPretty(value, indent = 3)), "JSON"))
)
