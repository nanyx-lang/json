-- a recursive type, a tree, is written and read back by walking its type
::dependency nanyx.json ./nanyx.json

import nanyx.json/json as json

type Tree = #leaf(int) | #node(left: Tree, right: Tree)

type Rose = #rose(label: string, children: list(Rose))

def tree: Tree = #node(left = #leaf(1), right = #node(left = #leaf(2), right = #leaf(3)))

def rose: Rose = #rose(
  label = "a"
  children = [
    #rose(label = "b", children = [])
    #rose(label = "c", children = [#rose(label = "d", children = [])])
  ]
)

def treeText = json.encode(tree) \orCrash("a Tree is written")
def roseText = json.encode(rose) \orCrash("a Rose is written")

println(treeText)
println(roseText)

match json.decode(treeText, into = type Tree)
  | #some(t) -> println(t == tree)
  | failure -> println(json.describe(failure))

match json.decode(roseText, into = type Rose)
  | #some(r) -> println(r == rose)
  | failure -> println(json.describe(failure))

match json.decode(
  '{"node": {"left": {"leaf": 1}, "right": {"node": {"left": {"leaf": "2"}, "right": {"leaf": 3}}}}}'
  into = type Tree
)
  | #some(_) -> println("read")
  | failure -> println(json.describe(failure))
