From b1df727113cf822e891e7caab82a68c79700ca6d Mon Sep 17 00:00:00 2001
From: Richard Gibson <richard@gibson.cx>
Date: Mon, 23 Nov 2026 14:20:01 +0000
Subject: [PATCH] Docs for nanyx.json 0.3.0: recursive types and
 json.encodeValue

The json pages and the JSON cookbook pin nanyx.json 0.3.0, and the json,
reflection page's reference is written from its doc comments. Compiler
0.35.0 fixed the bugs 0.2.0 listed as limits, so that page now shows a
tree and a field of type Json written and read by walking their type, with
json.encodeValue, and lists only what's left: #2382, and sets and maps with
keys other than strings can't be read.

The Wasm tests' package store holds nanyx.json 0.3.0, the .nyxpkg of its
release, and the encode page's pin test names it.
---
 .../Docs/StandardLibraryReferenceTests.fs     |   6 +-
 .../Packages/nanyx.json-0.3.0.nyxpkg          | Bin 0 -> 18932 bytes
 .../Nanyx.Compiler.Wasm.Tests/TestHelpers.fs  |   4 +-
 docs/src/content/cookbook/json-parsing.md     |  12 +--
 docs/src/content/stdlib/encode.md             |   6 +-
 docs/src/content/stdlib/json-reflection.md    |  93 ++++++++++++++++--
 docs/src/content/stdlib/json-typed.md         |   8 +-
 docs/src/content/stdlib/json.md               |  14 +--
 docs/src/content/stdlib/standard-library.md   |   2 +-
 9 files changed, 111 insertions(+), 34 deletions(-)
 create mode 100644 compiler/Nanyx.Compiler.Wasm.Tests/Packages/nanyx.json-0.3.0.nyxpkg

diff --git a/compiler/Nanyx.Compiler.Wasm.Tests/Features/Docs/StandardLibraryReferenceTests.fs b/compiler/Nanyx.Compiler.Wasm.Tests/Features/Docs/StandardLibraryReferenceTests.fs
index 98cc980..014f5c3 100644
--- a/compiler/Nanyx.Compiler.Wasm.Tests/Features/Docs/StandardLibraryReferenceTests.fs
+++ b/compiler/Nanyx.Compiler.Wasm.Tests/Features/Docs/StandardLibraryReferenceTests.fs
@@ -43,7 +43,7 @@ let ``A public module of a package the compiler ships has a page, but a host's m
     Assert.DoesNotContain("console-host", pages.Keys)
 
 /// What `StandardLibraryDocs.update` says of the page `page.md`, whose text is `text`, alone in a directory, with the
-/// tests' package store, which holds nanyx.json 0.1.0 and 0.2.0 and no other version.
+/// tests' package store, which holds nanyx.json 0.1.0, 0.2.0 and 0.3.0 and no other version.
 let private updateOf (text: string) =
     use directory = new TempDirectory()
     directory.Write "page.md" text
@@ -65,6 +65,6 @@ let ``A page that pins a version the index doesn't have, or a pin written wrong,
 [<Fact>]
 let ``A page of a published package's file has its reference from the version the page pins`` () =
     let page = File.ReadAllText(Path.Combine(docsContentDirectory, "stdlib", "encode.md"))
-    Assert.Equal(Result.Ok(Some("nanyx.json", (SemanticVersion.tryParse "0.2.0").Value)), StandardLibraryDocs.pinOf page)
-    Assert.Contains(StandardLibraryDocs.beginMarkerOf (Some("nanyx.json", (SemanticVersion.tryParse "0.2.0").Value)), page)
+    Assert.Equal(Result.Ok(Some("nanyx.json", (SemanticVersion.tryParse "0.3.0").Value)), StandardLibraryDocs.pinOf page)
+    Assert.Contains(StandardLibraryDocs.beginMarkerOf (Some("nanyx.json", (SemanticVersion.tryParse "0.3.0").Value)), page)
     Assert.Contains("## `string`", page)
diff --git a/compiler/Nanyx.Compiler.Wasm.Tests/Packages/nanyx.json-0.3.0.nyxpkg b/compiler/Nanyx.Compiler.Wasm.Tests/Packages/nanyx.json-0.3.0.nyxpkg
new file mode 100644
